# PostgreSQL (Neon / Supabase / Vercel Postgres compatible)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# REQUIRED: long random secret (32+ chars)
JWT_SECRET=replace-with-a-long-random-secret

# OWNER account created/updated on first startup
ADMIN_ID=brainmaster_owner
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional Gmail/SMTP for email verification + admin OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-gmail@gmail.com

# If frontend is on another domain, put it here. Multiple origins: comma-separated.
# Same-project Vercel deployment can stay *.
CORS_ORIGIN=*
DB_POOL_MAX=5
